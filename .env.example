# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> anon / publishable key (safe for the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API Keys -> service_role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
# Production URL, e.g. https://www.globalrotan.com (used for canonical URLs, sitemap, WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to hash visitor IPs for rate limiting
RATE_LIMIT_SALT=

# ---- Database (local scripts only: migrations, seed, admin promotion) ----
# Supabase -> Connect -> Session pooler (IPv4 compatible). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
